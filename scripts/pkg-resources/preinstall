#!/bin/bash
# preinstall — runs as root before the .pkg payload is written.
#
# Refuses to install over another NodeSpace product (ADR-084 §5). Every
# NodeSpace product installs to /Applications/NodeSpace.app, so this package
# would otherwise replace it. The Distribution installation check
# (build-pkg.sh) makes the same decision earlier, in the Installer window;
# this script covers every install, `installer` on the command line included.
#
# The installed bundle is free NodeSpace only when its Info.plist declares
# NodeSpaceProduct = community. Any other value, no key, or an Info.plist that
# cannot be read refuses. Nothing under the installed bundle is executed: the
# product is read from static data, with a system tool called by absolute path.
#
# Nothing overrides the refusal: the way past it is the one it names, moving
# the installed app to the Trash.
#
# The installed app is found through $3, the target volume, so a package
# installed to another volume checks that volume's copy. macOS Installer
# passes: $1 package path, $2 target location, $3 target volume, $4 startup
# disk.

set -euo pipefail

# $3 is "/" for the startup disk; dropping its trailing slash keeps the app
# path /Applications/NodeSpace.app.
VOLUME="${3:-/}"
APP="${VOLUME%/}/Applications/NodeSpace.app"

if [[ ! -e "${APP}" ]]; then
    exit 0
fi

product="$(/usr/bin/plutil -extract NodeSpaceProduct raw -o - "${APP}/Contents/Info.plist" 2>/dev/null || true)"

if [[ "${product}" != "community" ]]; then
    echo "The NodeSpace app on this Mac is a different NodeSpace product, or an older NodeSpace that does not say which product it is. To replace it, move /Applications/NodeSpace.app to the Trash, then run this installer again. Your databases stay on this Mac." >&2
    exit 1
fi
