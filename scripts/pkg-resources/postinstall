#!/bin/bash
# postinstall — runs as root after the .pkg payload is extracted.
#
# Payload layout (relative to the pkg's install location /):
#   usr/local/bin/nodespace
#   usr/local/bin/nodespaced
#   Applications/NodeSpace.app
#   Library/LaunchAgents/app.nodespace.daemon.plist
#
# This script:
#   1. Detects an existing Pro binary and aborts with a dialog if Community
#      would overwrite it (unless NODESPACE_FORCE_COMMUNITY=1 is set).
#   2. Fixes ownership/permissions on the installed files.
#   3. Loads the launchd service for the installing user.

set -euo pipefail

INSTALL_PREFIX="/usr/local/bin"
LAUNCHD_PLIST="/Library/LaunchAgents/app.nodespace.daemon.plist"
NODESPACED="${INSTALL_PREFIX}/nodespaced"

# ---------------------------------------------------------------------------
# Pro-edition guard
# The pkg installs Community binaries. If an existing Pro binary is already
# at /usr/local/bin/nodespaced, warn the user before overwriting it.
# ---------------------------------------------------------------------------
if [[ -x "${NODESPACED}" ]]; then
    # Verify the binary's code signature before executing it as root.
    # An unsigned or tampered binary should not be run with elevated privileges.
    if ! codesign --verify --quiet "${NODESPACED}" 2>/dev/null; then
        echo "Warning: existing nodespaced binary failed signature verification — skipping Pro guard" >&2
        EXISTING_EDITION="unknown"
    else
        EXISTING_EDITION="$("${NODESPACED}" --edition 2>/dev/null || echo "unknown")"
    fi
    if [[ "${EXISTING_EDITION}" == "pro" && "${NODESPACE_FORCE_COMMUNITY:-0}" != "1" ]]; then
        # Display a dialog on macOS so the user sees a clear warning.
        # Do NOT use || true here — osascript returns non-zero when the user
        # clicks Abort (AppleScript error -128), which is exactly how we detect
        # the abort. Suppressing the exit code would make the $? check below
        # always see 0 and never abort.
        /usr/bin/osascript - <<'APPLESCRIPT'
display dialog "You are installing NodeSpace Community, which would replace your Pro installation.

Continue anyway to install Community, or click Abort to keep your Pro installation." \
    buttons {"Abort", "Continue"} default button "Abort" with icon caution \
    giving up after 60
if button returned of result is "Abort" then
    error number -128
end if
APPLESCRIPT
        # If osascript returned non-zero (user aborted or timed out), stop.
        # shellcheck disable=SC2181
        if [[ $? -ne 0 ]]; then
            echo "Installation aborted — Pro installation preserved." >&2
            exit 1
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Log directory: create the per-user log directory for the LaunchAgent.
# This must be done before launchctl bootstrap so the daemon can write logs
# immediately on first start.
# ---------------------------------------------------------------------------
INSTALLING_USER_EARLY="${USER:-$(logname 2>/dev/null || echo "")}"
if [[ -n "${INSTALLING_USER_EARLY}" && "${INSTALLING_USER_EARLY}" != "root" ]]; then
    INSTALLING_USER_HOME=$(eval echo "~${INSTALLING_USER_EARLY}" 2>/dev/null || echo "")
    if [[ -n "${INSTALLING_USER_HOME}" && -d "${INSTALLING_USER_HOME}" ]]; then
        mkdir -p "${INSTALLING_USER_HOME}/Library/Logs/com.nodespace"
    fi
fi

# ---------------------------------------------------------------------------
# Permissions: binaries must be executable by all users.
# ---------------------------------------------------------------------------
chmod 755 "${INSTALL_PREFIX}/nodespace" || true
chmod 755 "${INSTALL_PREFIX}/nodespaced" || true
chown root:wheel "${INSTALL_PREFIX}/nodespace" || true
chown root:wheel "${INSTALL_PREFIX}/nodespaced" || true

# The .app bundle's own executables (NodeSpace itself, plus the externalBin
# sidecars staged beside it -- nodespace-skill-installer and any other
# bundled binaries) get the same install-time defense-in-depth as the two
# CLI binaries above. build-pkg.sh already chmods these before packaging
# (see its own comment), but this postinstall-time chmod is a second,
# independent line of defense against the executable bit being lost
# somewhere between that build step and the actual install on the user's
# machine -- the same reasoning build-pkg.sh's own chmod already applies to
# itself relative to the CI artifact round-trip.
#
# nullglob so a missing or empty Contents/MacOS (never expected -- the .app
# always ships with its own executable at minimum -- but not otherwise
# diagnosed here) skips the chmod instead of passing a literal, unmatched
# glob pattern to it.
APP_MACOS_DIR="/Applications/NodeSpace.app/Contents/MacOS"
if [[ -d "${APP_MACOS_DIR}" ]]; then
    shopt -s nullglob
    APP_MACOS_BINS=("${APP_MACOS_DIR}/"*)
    shopt -u nullglob
    if [[ ${#APP_MACOS_BINS[@]} -gt 0 ]]; then
        if ! chmod 755 "${APP_MACOS_BINS[@]}"; then
            echo "Warning: failed to chmod ${APP_MACOS_DIR}/* — continuing install" >&2
        fi
    fi
fi

# ---------------------------------------------------------------------------
# LaunchAgent: load the service for the current (GUI) user.
# The plist was installed to /Library/LaunchAgents/ so it applies to all
# users on the machine; we only bootstrap it for the installing user here.
#
# `launchctl bootstrap` returns error 5 (EIO) both when the label is already
# registered and when the bootout above is still mid-teardown (a race) —
# neither is a real failure. By this point in the script the binaries are
# already installed and signed, so a registration hiccup must not fail the
# whole package. We retry once (teardown races typically resolve within a
# second) and, if the service ends up loaded either way, treat that as
# success. Only a bootstrap failure that leaves the service NOT loaded after
# the retry is reported — without aborting the install.
# ---------------------------------------------------------------------------
# --- BEGIN launchd-bootstrap (verified by scripts/postinstall-bootstrap.test.ts) ---
INSTALLING_USER="${USER:-$(logname 2>/dev/null || echo "")}"
if [[ -n "${INSTALLING_USER}" && "${INSTALLING_USER}" != "root" ]]; then
    USER_UID=$(id -u "${INSTALLING_USER}" 2>/dev/null || echo "")
    if [[ -n "${USER_UID}" ]]; then
        SERVICE_TARGET="gui/${USER_UID}/app.nodespace.daemon"

        # Unload any existing registration first (ignore error if not loaded).
        launchctl bootout "${SERVICE_TARGET}" 2>/dev/null || true

        if ! launchctl bootstrap "gui/${USER_UID}" "${LAUNCHD_PLIST}" 2>/dev/null; then
            # Bootstrap failed — most likely EIO because the label is still
            # mid-teardown from the bootout above, or was already registered
            # by something else. Give teardown a moment and retry once.
            sleep 1
            if ! launchctl bootstrap "gui/${USER_UID}" "${LAUNCHD_PLIST}" 2>/dev/null; then
                # Still failing after the retry. If the service is
                # nonetheless loaded (e.g. it was already registered and
                # never actually went away), that's the harmless case —
                # treat it as success rather than a broken install.
                if launchctl print "${SERVICE_TARGET}" &>/dev/null; then
                    echo "Note: app.nodespace.daemon was already registered; reused the existing registration." >&2
                else
                    # Genuinely failed to register. Binaries are already
                    # installed and signed at this point — do not fail the
                    # whole package over a service-registration error the
                    # user can recover from (log out/in, or re-run manually).
                    echo "Warning: failed to register the app.nodespace.daemon launchd service. Installation completed, but the background service is not running." >&2
                    echo "         Run manually: launchctl bootstrap gui/${USER_UID} ${LAUNCHD_PLIST}" >&2
                fi
            fi
        fi
    fi
fi
# --- END launchd-bootstrap ---

exit 0
