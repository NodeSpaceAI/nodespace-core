<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Must match the label the bundled NodeSpace.app registers itself
         under (daemon_setup.rs's launch_agent_label(), release build:
         "app.nodespace.daemon") -- not an arbitrary pkg-specific name.
         Under a different label, the .pkg's system-wide LaunchAgent and
         the app's own first-launch registration are two independent
         daemons instead of one, so a "Quit" from the tray only ever stops
         the one the app itself started. -->
    <key>Label</key>
    <string>app.nodespace.daemon</string>

    <!-- This plist is shared by every user of the Mac, and launchd does NOT
         expand "~" or environment variables in StandardOutPath /
         StandardErrorPath (a "~" there makes the job fail to start with
         EX_CONFIG, exit 78). The daemon writes no log file of its own and
         logs to its stdout/stderr, so a small shell resolves the log file
         per user at run time: it makes ~/.nodespace (owner-only when new; a
         umask here would leak into the daemon) and ~/.nodespace/logs (the directory the
         app's own per-user registration and `nodespace logs` use) and then
         `exec`s the daemon with stdout and stderr appended to the log, so
         the daemon replaces the shell (same pid, command line
         "/usr/local/bin/nodespaced --tray") and the log rotation can reach
         the file behind its stdio.
         The tray flag opts into the tray icon; the daemon is headless
         without it. Matches daemon_setup.rs's write_plist. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>mkdir -p -m 700 "$HOME/.nodespace" &amp;&amp; mkdir -p "$HOME/.nodespace/logs" &amp;&amp; exec /usr/local/bin/nodespaced --tray &gt;&gt;"$HOME/.nodespace/logs/nodespaced.log" 2&gt;&amp;1</string>
    </array>

    <!-- Conditional restart: only on a nonzero/crash exit, not on every
         exit. Bare `true` restarted the daemon even after a clean,
         deliberate shutdown (e.g. the tray's "Quit"), undoing it within
         about a hundred milliseconds. Matches daemon_setup.rs's write_plist
         and the Linux systemd unit's Restart=on-failure. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Start at login; do not require the user to manually launch. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Throttle rapid restart loops (e.g. crash on startup) to 10s. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
