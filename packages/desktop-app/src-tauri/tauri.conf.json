{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NodeSpace",
  "version": "0.2.10",
  "identifier": "com.nodespace.desktop",
  "build": {
    "beforeDevCommand": "bunx vite dev --port 1422",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "NodeSpace AI",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/models/**/*",
      "resources/skill/**/*"
    ],
    "externalBin": [
      "binaries/nodespaced",
      "binaries/nodespace",
      "binaries/nodespace-skill-installer"
    ]
  }
}
