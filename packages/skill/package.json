{
  "name": "@nodespaceai/skill",
  "version": "0.2.0",
  "description": "NodeSpace skill package \u2014 install NodeSpace tools into PTY agents (Claude Code, Codex, Antigravity CLI, OpenCode, Pi)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "nodespace-skill": "dist/install.js"
  },
  "files": [
    "dist",
    "plugins",
    "SKILL.md",
    "references"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "preinstall": "[ -f ../../enforce-bun.js ] && node ../../enforce-bun.js || true",
    "build": "tsc",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "test:plugin": "claude plugin validate plugins/claude-code && claude plugin test plugins/claude-code",
    "quality:check": "bunx tsc --noEmit && bunx tsc -p tsconfig.plugins.json",
    "quality:fix": "bunx tsc --noEmit && bunx tsc -p tsconfig.plugins.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@opencode-ai/plugin": "1.18.34",
    "@types/node": "^24.6.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "license": "FSL-1.1-ALv2"
}
