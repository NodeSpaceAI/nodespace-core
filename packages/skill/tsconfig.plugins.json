{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noUncheckedIndexedAccess": true
  },
  "include": ["plugins/pi/**/*", "plugins/opencode/**/*", "plugins/shared/**/*", "plugins/codex/**/*", "plugins/antigravity/**/*"],
  "exclude": ["node_modules", "dist"]
}
