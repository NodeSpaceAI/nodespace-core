{
  "name": "nodespace-core",
  "version": "0.2.9",
  "description": "NodeSpace AI-native knowledge management system with plugin architecture",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node enforce-bun.js",
    "dev:browser": "bun run --cwd packages/desktop-app dev:browser",
    "dev:tauri": "bun run --cwd packages/desktop-app dev:tauri",
    "dev": "bun run dev:browser",
    "demo:browser": "bun run --cwd packages/desktop-app demo:browser",
    "demo:tauri": "bun run --cwd packages/desktop-app demo:tauri",
    "build": "bun run build:skill && bun run --cwd packages/desktop-app build",
    "test": "bun run --cwd packages/desktop-app test",
    "test:watch": "bun run --cwd packages/desktop-app test:watch",
    "test:db": "bun run --cwd packages/desktop-app test:db",
    "test:db:watch": "bun run --cwd packages/desktop-app test:db:watch",
    "test:coverage": "bun run --cwd packages/desktop-app test:coverage",
    "test:scripts": "bun test scripts/",
    "test:skill": "bun run --cwd packages/skill test",
    "test:e2e": "bun run --cwd packages/desktop-app test:e2e",
    "test:webkit": "bun run --cwd packages/desktop-app test:webkit",
    "test:all": "bun run test:coverage && bun run test:scripts && bun run test:skill && bun run rust:test",
    "test:all:db": "bun run test:db && bun run test:scripts && bun run test:skill && bun run rust:test",
    "check": "bun run --cwd packages/desktop-app check",
    "check:watch": "bun run --cwd packages/desktop-app check:watch",
    "tauri:dev": "bun run dev:tauri",
    "tauri:build": "cd packages/desktop-app && bun run tauri:build",
    "install:all": "bun install",
    "chat": "bun run scripts/aichat.ts",
    "eval:routing": "bun run scripts/eval/routing.ts",
    "eval:agent": "bun run scripts/eval/agent-matrix.ts",
    "prompt:dump": "bun run scripts/prompt-dump.ts",
    "build:sidecars": "bun run scripts/build-sidecars.ts",
    "skill:gen": "cargo run -q -p nodespace-cli --example gen_skill_md -- --write",
    "skill:check": "cargo run -q -p nodespace-cli --example gen_skill_md -- --check",
    "build:skill": "bun run skill:check && bun run scripts/build-skill.ts",
    "build:pkg:macos": "bash scripts/build-pkg.sh",
    "download:models": "bun run scripts/download-models.ts",
    "download:models:bundle": "bun run scripts/download-models.ts --bundle",
    "gh:status": "bun run scripts/gh-utils.ts issues:status",
    "gh:assign": "bun run scripts/gh-utils.ts issues:assign",
    "gh:unassign": "bun run scripts/gh-utils.ts issues:unassign",
    "gh:create": "bun run scripts/gh-utils.ts issues:create",
    "gh:edit": "bun run scripts/gh-utils.ts issues:edit",
    "gh:comment": "bun run scripts/gh-utils.ts issues:comment",
    "gh:list": "bun run scripts/gh-utils.ts issues:list",
    "gh:startup": "bun run scripts/gh-utils.ts issues:startup",
    "gh:view": "bun run scripts/gh-utils.ts issues:view",
    "gh:pr": "bun run scripts/gh-utils.ts pr:create",
    "gh:help": "bun run scripts/gh-utils.ts",
    "review:status": "bun run scripts/review-manager.ts --status",
    "review:reset": "bun run scripts/review-manager.ts --reset",
    "review:full": "bun run scripts/review-manager.ts --mode full",
    "review:delta": "bun run scripts/review-manager.ts --mode delta",
    "review:help": "bun run scripts/review-manager.ts --help",
    "rust:test": "bun run rust:test:workspace && bun run rust:test:core && bun run rust:test:libsql-linked && bun run rust:test:app-units",
    "rust:test:workspace": "cargo test --lib --bins --tests --workspace --exclude nodespace-app --exclude nodespace-app-test-support --exclude nodespace-core --exclude nodespace-agent --exclude nodespace-daemon --exclude nodespace-cli -- --test-threads=2",
    "rust:test:core": "cargo test --lib --bins --tests -p nodespace-core -- --test-threads=1",
    "rust:test:libsql-linked": "cargo test --lib --bins --tests -p nodespace-agent -p nodespace-daemon -p nodespace-cli -- --test-threads=1",
    "rust:test:app-units": "bun run scripts/test-app-units.ts",
    "rust:test:lib": "cargo test --lib -p nodespace-core -- --test-threads=1",
    "rust:test:long": "RUN_LONG_TESTS=1 cargo test --lib -p nodespace-core -- --test-threads=1",
    "rust:test:doc": "cargo test --doc",
    "rust:benchmark": "cargo test --lib -- --ignored --nocapture",
    "rust:benchmark:get": "cargo test --lib benchmark_get_nodes_batch -- --ignored --nocapture",
    "rust:benchmark:update": "cargo test --lib benchmark_update_nodes_batch -- --ignored --nocapture",
    "rust:format": "cargo fmt --all",
    "rust:format:check": "cargo fmt --all --check",
    "rust:lint": "cargo clippy --all-targets -- -D warnings -D clippy::unused-async",
    "rust:quality": "bun run rust:format:check && bun run rust:lint",
    "rust:quality:fix": "bun run rust:format && bun run rust:lint",
    "quality:scripts:fix": "bunx eslint --fix 'scripts/**/*.ts' && bunx tsc --noEmit -p scripts/tsconfig.json",
    "quality:scripts:check": "bunx eslint 'scripts/**/*.ts' && bunx tsc --noEmit -p scripts/tsconfig.json",
    "quality:fix": "bun run quality:scripts:fix && bun run --cwd packages/desktop-app quality:fix && bun run --cwd packages/skill quality:fix && bun run rust:quality:fix",
    "quality:check": "bun run quality:scripts:check && bun run --cwd packages/desktop-app quality && bun run --cwd packages/skill quality:fix && bun run rust:quality",
    "container:build": "bun run scripts/container.ts build",
    "container:run": "bun run scripts/container.ts run",
    "container:run:setup": "bun run scripts/container.ts run:setup",
    "container:save": "bun run scripts/container.ts save",
    "container:list": "bun run scripts/container.ts list",
    "container:stop": "bun run scripts/container.ts stop",
    "container:resize": "bun run scripts/container.ts resize",
    "container:help": "bun run scripts/container.ts",
    "release": "bun run scripts/release.ts",
    "release:list": "bun run scripts/release.ts list",
    "release:watch": "bun run scripts/release.ts watch",
    "release:view": "bun run scripts/release.ts view",
    "release:delete": "bun run scripts/release.ts delete",
    "release:bump": "bun run scripts/release.ts bump",
    "release:help": "bun run scripts/release.ts --help",
    "homebrew:sync": "bun run scripts/update-homebrew-cask.ts",
    "homebrew:drift-check": "bun run scripts/update-homebrew-cask.ts drift-check",
    "homebrew:sync-formula": "bun run scripts/update-homebrew-formula.ts",
    "homebrew:formula-drift-check": "bun run scripts/update-homebrew-formula.ts drift-check",
    "prepare": "husky",
    "audit": "bun scripts/audit-npm.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/jsdom": "^21.1.7",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "bun-types": "latest",
    "eslint": "^9.32.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.2"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0",
    "npm": "Please use Bun instead",
    "yarn": "Please use Bun instead",
    "pnpm": "Please use Bun instead"
  },
  "packageManager": "bun@1.0.0",
  "dependencies": {
    "@octokit/graphql": "^9.0.1",
    "@octokit/rest": "^22.0.0",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.9.18",
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001766",
    "core-js-compat": "^3.48.0",
    "eslint-plugin-unicorn": "^62.0.0"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.9.18",
    "@grpc/grpc-js": "1.14.4",
    "@sveltejs/kit": "2.70.1",
    "devalue": "5.8.2",
    "dompurify": "3.4.12",
    "form-data": "4.0.6",
    "js-yaml": "4.3.0",
    "lodash-es": "4.18.1",
    "mermaid": "11.16.0",
    "postcss": "8.5.23",
    "protobufjs": "7.6.5",
    "shell-quote": "1.10.0",
    "svelte": "5.56.8",
    "uuid": "11.1.1",
    "ws": "8.21.1"
  },
  "resolutions": {
    "baseline-browser-mapping": "^2.9.18"
  }
}
