# Rust build artifacts (ensure target never gets committed)
target/
# Tauri dev-mode sidecar cache (kept in sync by dev:tauri:sidecars)
target/debug/binaries/
**/*.rs.bk
*.pdb
# Cargo.lock is committed for reproducible builds (application crate best practice)

# Rust debug/profiling
*.prof
*.profraw
perf.data*

# Generated by build scripts
*.a
*.lib
*.dylib
*.dll
*.so
*.exe

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tauri_debug.log

# Node.js
node_modules/
dist/
dist-ssr/
*.local
build/
out/

