*.coverage
junit.xml
*.xml
*.html.meta.json.gz
results.json
.playwright-mcp/

# Temporary files
*.tmp
*.temp
*.bak
*.backup
history.txt

# Per-run routing matrix (tests/live_openai_compat_routing.rs). Machine-specific
# — its rows depend on which models the runner's endpoint serves — so tracking it
# makes an ordinary re-run look like a changed finding. Paste runs into the
# tracking issue instead, matching how aichat-matrix.ts results are handled.
packages/agent/tests/routing-matrix-latest.txt

# Per-run compound-intent trace (tests/live_stage1_compound_intent.rs). Same
# rationale as the routing matrix above.
packages/agent/tests/stage1-compound-intent-latest.txt

# Rust tooling installed by scripts/setup-rust-tooling.ts (shared by all worktrees)
.tools
